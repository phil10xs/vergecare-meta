# Copy to .env.local and adjust.
# Local Homebrew Postgres (default):
DATABASE_URL=postgres://igbobaphilip@localhost:5432/vergefield
# Docker alternative (`docker compose up -d`, avoids clashing with the default Postgres on 5432):
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/vergefield
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Production magic-link origin (set on the box; local stays on localhost):
# APP_URL=https://demo-vergesnag.goverge.app
# NEXT_PUBLIC_APP_URL=https://demo-vergesnag.goverge.app
# SES — same AWS account as GoVerge. Leave unset locally: the UI says nothing
# was sent and still opens the board. Sender must be a verified goverge.app
# identity (GoVerge uses SES_FROM_EMAIL / SES_FROM_NAME).
# SES_FROM_EMAIL=
# SES_FROM_NAME=VergeSnag
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=
# Meta Model API key (Meta dashboard) — enables video transcription.
# Without it, requests still work; transcripts show as unavailable.
META_MODEL_API_KEY=
